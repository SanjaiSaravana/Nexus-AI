# ==============================================================================
# NEXUS AI Root .gitignore
# ==============================================================================

# Python & Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
Scripts/
pyvenv.cfg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linters
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.oxlint_cache/

# Databases & Local SQLite Storage
*.db
*.sqlite
*.sqlite3
nexus.db
backend/nexus.db

# Sensitive Environment Configurations (NEVER commit secrets!)
.env
.env.local
.env.*.local
.env.production
backend/.env
frontend/.env
frontend/.env.local

# Preserve example config templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# MLOps & Experiment Tracking
mlruns/
mlartifacts/
backend/mlruns/
backend/mlartifacts/

# Docker Local Volumes
postgres_data/
neo4j_data/

# Logs & Temporary Files
logs/
*.log
scratch/
tmp/
temp/

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
