# NEXUS AI Configuration
PROJECT_NAME="NEXUS AI"
SECRET_KEY="your-super-secret-jwt-key-min-32-chars-long"

# Database
DATABASE_URL="sqlite+aiosqlite:///./nexus.db"

# Optional OpenAI API Key (Nexus AI works offline without this using built-in local inference)
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Neo4j Knowledge Graph (Optional: uses automated in-memory graph fallback if Neo4j is offline)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="nexuspassword"
NEO4J_DATABASE="neo4j"
